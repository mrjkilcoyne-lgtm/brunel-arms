{
  "name": "brunel-engine",
  "version": "1.0.0",
  "description": "Turn frustrations into actionable insight",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint .",
    "format": "prettier --write '**/*.{js,json,md}' --ignore-path .gitignore",
    "format:check": "prettier --check '**/*.{js,json,md}' --ignore-path .gitignore",
